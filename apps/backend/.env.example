# OpenAI
OPENAI_API_KEY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/misi-langgraph

# LangSmith (optional but recommended for observability)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=misi-langgraph

# GitHub
GITHUB_TOKEN=

# Docker (runtime subgraph)
NODE_DOCKER_IMAGE=node:20-slim
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
SCRIPT_TIMEOUT_SECONDS=120

# CodeGraph (blast-radius analysis of the target repo)
CODEGRAPH_DOCKER_IMAGE=codegraph-cli:latest

# Trivy (vulnerability/license scanning + SBOM/dependency-graph generation)
TRIVY_IMAGE=aquasec/trivy:0.71.2
TRIVY_CACHE_DIR=tmp/trivy-cache

# Tavily (web search for conductor)
TAVILY_API_KEY=

# Analysis parameters
LOOKBACK_DAYS=90
REVIEWER_BATCH_SIZE=20
REPO_CACHE_MAX_AGE_DAYS=1
RUNTIME_CACHE_MAX_AGE_DAYS=30
# Currently unused: collect_licenses now sources license data from
# trivy_license_scan instead of npm registry lookups. Kept in case a
# fallback/enrichment lookup path is reintroduced in the future.
LICENSE_LOOKUP_CONCURRENCY=10
# Minimum severity for risk findings, applied in both the analysis subgraph
# (dropped before report enrichment) and the report subgraph (dropped again
# before persisting). Set to e.g. "medium" to skip enrichment/reporting work
# on low/info findings entirely.
# Values: any | low | medium | high | critical  (default: any)
RISK_MIN_SEVERITY=any
# Minimum severity for vulnerability findings from the dependency audit.
# npm/pnpm `audit --json` is not filtered by --audit-level, so we filter here.
# Values: low | medium | high | critical  (default: high)
VULN_MIN_SEVERITY=high
