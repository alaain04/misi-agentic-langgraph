APP_NAME=entity-worker
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=misi

REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300

NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=ENTITY_FETCH
NATS_SUBJECT_PREFIX=entity.fetch
NATS_MAX_DELIVER=5
NATS_TRANSIENT_BACKOFF_BASE=5.0
NATS_TRANSIENT_BACKOFF_CAP=300.0

GITHUB_TOKEN=your-github-token-here
GITHUB_ISSUES_LOOKBACK_DAYS=30
GITHUB_RELEASES_LOOKBACK_DAYS=90

NPM_RATE_WINDOWS=[(60, 500), (3600, 5000)]
GITHUB_RATE_WINDOWS=[(60, 100), (3600, 5000)]

WORKER_CONCURRENCY=5
MAX_RETRIES=3
